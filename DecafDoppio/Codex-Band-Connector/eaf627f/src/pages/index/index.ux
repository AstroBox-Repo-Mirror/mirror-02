  },
  onBackPress() {
    return "inbox" !== this.view && (this.back(), !0);
  },
  textHeight(t, e, i) {
    let _ = 1,
      o = 0;
    return Array.from(t || "").forEach(t => {
      if ("\n" === t) {
        _++, o = 0;
