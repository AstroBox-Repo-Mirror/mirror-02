<template>
  <div class="page">
    <div class="inbox" if="{{view === 'inbox'}}">
      <text class="home-clock">{{clockText}}</text>
      <div class="brand"><text class="brand-line">Codex</text><text class="brand-line">Connector</text></div>
      <text class="connection-status {{connectionHealthy ? 'healthy' : connectionPaused ? 'paused' : 'unhealthy'}}">{{connectionText}}</text>
      <scroll class="inbox-body" scroll-y="true">
        <div class="column" style="height:{{requests.length ? requests.length * 108 : 208}}px;">
          <text class="empty" if="{{requests.length === 0}}">暂无待处理请求</text>
          <div class="request" for="{{requests}}" tid="id" onclick="open($item.id)">
            <div class="request-row"><text class="request-title">{{$item.label}}</text><text class="time">{{$item.time}}</text></div>
            <text class="project">{{$item.project}}</text>
          </div>
        </div>
      </scroll>
      <div class="dock">
        <div class="icon-button blue" onclick="refresh"><image class="icon" src="/common/refresh_glyph.png" /></div>
        <div class="icon-button" onclick="settings"><image class="icon" src="/common/gear_hex.png" /></div>
      </div>
    </div>
    <div class="detail" if="{{view === 'detail'}}">
      <div class="question-banner" if="{{!isApproval}}"><div class="question-mark"><text class="question-symbol">?</text></div><text class="question-title">Codex 有个问题</text></div>
      <div class="pill deny top-action" if="{{isApproval}}" onclick="deny"><image class="action-icon" src="/common/reject.png" /></div>
      <scroll class="detail-body {{isApproval ? '' : 'question-body'}}" scroll-y="true"><div class="column" style="height:{{contentHeight}}px;"><text class="content {{isApproval ? '' : 'question-content'}}" style="height:{{contentHeight}}px;">{{content}}</text></div></scroll>
      <div class="pill allow bottom-action" if="{{isApproval && canApprove}}" onclick="approve"><image class="action-icon" src="/common/approve.png" /></div>
      <div class="pill inactive bottom-action" if="{{isApproval && !canApprove}}"><image class="action-icon" src="/common/approve.png" /></div>
    </div>
    <div class="settings" if="{{view === 'settings'}}">
      <text class="settings-title">设置</text>
      <scroll class="settings-body" scroll-y="true">
        <div class="settings-list" style="height:{{fixtureMode ? 960 : 500}}px;">
          <div class="setting-card" onclick="toggleEnabled"><text class="setting-label">启用监听</text><div class="toggle {{enabled ? 'toggle-on' : ''}}"><div class="knob {{enabled ? 'knob-on' : ''}}"></div></div></div>
          <div class="explanation-block"><text class="explanation">{{enabled ? '已开启监听' : '监听已关闭'}}</text><text class="explanation">{{connectionLabel}}</text></div>
          <div class="setting-card" onclick="toggleAuto"><text class="setting-label">电脑连接 自动启用</text><div class="toggle {{autoPc ? 'toggle-on' : ''}}"><div class="knob {{autoPc ? 'knob-on' : ''}}"></div></div></div>
          <div class="setting-card" onclick="toggleVibrate"><text class="setting-label">震动提醒</text><div class="toggle {{vibrate ? 'toggle-on' : ''}}"><div class="knob {{vibrate ? 'knob-on' : ''}}"></div></div></div>
          <div class="setting-card" onclick="toggleFullscreen"><text class="setting-label">前台全屏
提醒</text><div class="toggle {{fullscreen ? 'toggle-on' : ''}}"><div class="knob {{fullscreen ? 'knob-on' : ''}}"></div></div></div>
          <div class="setting-button" onclick="ping"><text class="bind-label">{{connectionTestText}}</text></div>
          <input class="setting-button" type="button" value="模拟新请求" if="{{fixtureMode}}" onclick="simulateNew" />
          <input class="setting-button" type="button" value="模拟过期" if="{{fixtureMode}}" onclick="simulateExpire" />
          <input class="setting-button" type="button" value="模拟断连" if="{{fixtureMode}}" onclick="simulateDisconnect" />
          <input class="setting-button" type="button" value="恢复连接" if="{{fixtureMode}}" onclick="simulateReconnect" />
        </div>
      </scroll>
      <div class="bind-action" onclick="forgetHost"><text class="binding-label">{{bindConfirm ? (hostBound ? '确认解除绑定' : '确认绑定电脑') : (hostBound ? '解除电脑绑定' : '绑定当前电脑')}}</text></div>
      <div class="exit-action" onclick="stop"><text class="exit-label">退出并清理缓存</text></div>
    </div>
    <div class="hint" if="{{hint}}"><text class="hint-text">{{hint}}</text></div>
  </div>
</template>
<script>
import * as _ from "../../common/build_flags.js";
