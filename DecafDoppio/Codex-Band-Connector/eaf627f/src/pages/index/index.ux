.exit-label {width:132px;font-size:18px;color:#ffffff;text-align:center;}
.hint {position:absolute;left:22px;top:342px;width:168px;min-height:48px;padding-top:10px;padding-right:10px;padding-bottom:10px;padding-left:10px;background-color:#303138;border-radius:20px;}
.hint-text {width:148px;font-size:20px;color:#ffffff;text-align:center;}
</style>
