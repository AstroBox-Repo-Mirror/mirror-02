      let i = 128 > t.charCodeAt(0) ? /[WM@]/.test(t) ? e : .8 * e : e;
      o + i > 178 && (_++, o = 0), o += i;
    }), Math.max(278, (_ + 3) * i);
  },
  armClock() {
    this.clockTimer && s(this.clockTimer), this.updateClock(), this.clockTimer = n(() => this.armClock(), 6e4 - Date.now() % 6e4);
  },
  updateClock() {
    let t = this.time24(Date.now());
    t !== this.clockText && (this.clockText = t);
  },
  time24(t) {
    if ("number" != typeof t) return "";
    let e = new Date(t),
      i = t => (t < 10 ? "0" : "") + t;
    return i(e.getHours()) + ":" + i(e.getMinutes());
  },
  toggleEnabled() {
    this.enabled ? this.stop() : this.start();
  },
  toggleVibrate() {
    this.bridge.controller.toggleVibrate();
  },
  toggleFullscreen() {
    this.bridge.controller.toggleFullscreen();
  },
  open(t) {
    this.showTechnical = !1, this.bridge.controller.open(t);
  },
  refresh() {
    this.bridge.controller.refresh();
  },
  settings() {
    this.bridge.controller.screen("settings"), this.view = "settings";
  },
  toggleTechnical() {
    this.showTechnical = !this.showTechnical;
  },
  previous() {
    let t = this.bridge.controller;
    t.state.detail && t.page(t.state.detail.page - 1);
  },
  next() {
    let t = this.bridge.controller;
    t.state.detail && t.page(t.state.detail.page + 1);
