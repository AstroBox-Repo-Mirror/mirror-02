.question-body {top:118px;height:350px;}
.content {width:180px;font-size:24px;line-height:34px;lines:-1;color:#ffffff;flex-shrink:0;}
.question-content {font-size:24px;line-height:34px;}
.pager {position:absolute;left:46px;top:390px;width:120px;height:32px;flex-direction:row;justify-content:space-between;}
