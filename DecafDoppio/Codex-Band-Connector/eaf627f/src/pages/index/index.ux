.explanation {width:164px;height:24px;line-height:24px;lines:1;font-size:18px;color:#a4a5ac;flex-shrink:0;}
.setting-button {width:188px;height:64px;border-radius:28px;background-color:#202127;color:#ffffff;font-size:22px;margin-bottom:12px;align-items:center;justify-content:center;flex-shrink:0;}
