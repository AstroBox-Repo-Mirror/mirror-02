.binding-label {width:132px;font-size:18px;color:#ffffff;text-align:center;}
.bind-label {width:164px;font-size:22px;color:#ffffff;text-align:center;}
.settings-body {position:absolute;left:12px;top:102px;width:188px;height:248px;}
.settings-list {width:188px;flex-direction:column;flex-shrink:0;}
.setting-card {width:188px;min-height:76px;padding-top:14px;padding-right:12px;padding-bottom:14px;padding-left:12px;background-color:#202127;border-radius:24px;margin-bottom:10px;align-items:center;justify-content:space-between;flex-shrink:0;}
.setting-label {width:112px;font-size:22px;color:#ffffff;}
