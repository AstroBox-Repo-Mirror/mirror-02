  simulateReconnect() {
    this.bridge.simulationAction("reconnect");
  }
};
</script>
<style>
.paused {color:#e6ad4a;}
.page {width:212px;height:520px;background-color:#000000;}
.inbox {position:absolute;left:0px;top:0px;width:212px;height:520px;flex-direction:column;}
.detail {position:absolute;left:0px;top:0px;width:212px;height:520px;flex-direction:column;}
.settings {position:absolute;left:0px;top:0px;width:212px;height:520px;flex-direction:column;}
.brand {position:absolute;left:24px;top:82px;width:164px;flex-direction:column;}
.brand-line {width:164px;height:34px;font-size:26px;color:#ffffff;text-align:center;}
.connection-status {position:absolute;left:12px;top:164px;width:188px;height:22px;font-size:16px;text-align:center;}
.healthy {color:#2fc86a;}
.unhealthy {color:#ff5364;}
.column {width:100%;flex-direction:column;}
.home-clock {position:absolute;left:40px;top:26px;width:132px;height:44px;font-size:36px;line-height:44px;color:#ffffff;text-align:center;}
.inbox-body {position:absolute;left:12px;top:208px;width:188px;height:208px;}
.request {width:188px;height:96px;flex-shrink:0;flex-direction:column;background-color:#202127;border-radius:24px;padding-top:12px;padding-right:12px;padding-bottom:12px;padding-left:12px;margin-bottom:12px;}
.request-row {width:164px;height:32px;flex-shrink:0;flex-direction:row;align-items:center;}
.request-title {font-size:24px;line-height:32px;height:32px;lines:1;flex-shrink:0;color:#ffffff;width:104px;}
.time {font-size:20px;line-height:32px;height:32px;lines:1;flex-shrink:0;color:#c4c5cb;width:60px;text-align:right;}
.project {width:164px;height:28px;line-height:28px;lines:1;flex-shrink:0;font-size:20px;color:#a4a5ac;margin-top:8px;}
.empty {font-size:22px;color:#a4a5ac;text-align:center;margin-top:55px;width:188px;}
.dock {position:absolute;left:42px;top:436px;width:128px;height:56px;flex-direction:row;justify-content:space-between;}
.icon-button {width:56px;height:56px;border-radius:28px;background-color:#202127;align-items:center;justify-content:center;}
.blue {background-color:#1677ff;}
.icon {width:32px;height:32px;}
.gear {width:44px;height:44px;font-size:34px;color:#ffffff;text-align:center;}
.pill {position:absolute;left:34px;width:144px;height:64px;border-radius:32px;align-items:center;justify-content:center;}
.top-action {top:24px;}
.bottom-action {top:432px;}
.action-icon {width:36px;height:36px;}
.allow {background-color:#2fc86a;}
.deny {background-color:#fa4258;}
.inactive {background-color:#183e28;}
.detail-body {position:absolute;left:16px;top:108px;width:180px;height:278px;}
