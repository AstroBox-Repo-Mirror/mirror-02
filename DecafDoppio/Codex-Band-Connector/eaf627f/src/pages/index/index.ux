      Object.defineProperty(t, e, Object.getOwnPropertyDescriptor(i, e));
    });
  }
  return t;
}
export default {
  private: {
    clockText: "--:--",
    hostBound: !1,
    connectionTestText: "测试连接",
    bindConfirm: !1,
    view: "inbox",
    status: "连接电脑后同步",
    requests: [],
    content: "",
    pageLabel: "",
    canApprove: !1,
    isApproval: !1,
    reason: "",
    contentHeight: 278,
    showTechnical: !1,
    hint: "",
    autoPc: !0,
    keepAlive: !1,
    vibrate: !0,
    fullscreen: !0,
    connectionLabel: "尚未连接电脑",
    connectionHealthy: !1,
    connectionPaused: !1,
    connectionText: "未连接电脑",
    enabled: !0,
    autoLabel: "电脑连接自动启用：开",
    audioValidated: !1,
    probeBuild: _.PROBE_BUILD,
    simulatorMode: _.SIMULATOR_BUILD,
    simulatorLabel: _.LIVE_SIMULATOR_BUILD ? "模拟手环 \xb7 控制真实 Codex 授权" : "模拟环境 \xb7 不执行电脑操作",
    fixtureMode: _.SIMULATOR_BUILD && !_.LIVE_SIMULATOR_BUILD
  },
  onInit() {
    this.armClock(), this.bridge = this.$app.$def.getBridge(), this.unsubscribe = this.bridge.subscribe(t => {
      this.hostBound = !!t.hostId && !t.bindingRequired, this.connectionTestText = t.connectionTestText, this.connectionPaused = t.connected && t.safetyPaused, this.connectionHealthy = t.enabled && t.connected && t.bridgeEnabled && !t.safetyPaused, this.connectionText = this.connectionHealthy ? "电脑已连接" : t.enabled ? !t.connected && t.transportCode ? "互联未建立(" + t.transportCode + ")" : t.connected ? t.safetyPaused ? "电脑已连，推送暂停" : t.bridgeEnabled ? "电脑已连接" : "电脑桥接已暂停" : "电脑服务无响应" === t.status ? "电脑无响应" : t.bindingRequired ? "未绑定电脑" : t.status.indexOf("身份改变") >= 0 ? "电脑身份不符" : t.hostId ? "电脑连接中断" : "未连接电脑" : "监听已关闭", this.connectionLabel = t.connected ? "已连接电脑" : t.hostId ? "请检查电脑连接" : "尚未绑定电脑", this.status = (_.LIVE_SIMULATOR_BUILD ? "本机：" : _.SIMULATOR_BUILD ? "模拟：" : "") + t.status, this.requests = t.requests.slice().sort((t, e) => (t.createdAt || 0) - (e.createdAt || 0)).map(t => r(r({}, t), {}, {
        label: "approval" === t.kind ? "请求批准" : "有个问题",
        time: this.time24(t.createdAt),
        project: t.project || "未命名项目"
      })), this.autoPc = t.autoPc, this.vibrate = t.vibrate, this.fullscreen = t.fullscreen, this.keepAlive = t.keepAlive, t.hint && t.hintId !== this.lastHintId && (this.lastHintId = t.hintId, this.hint = t.hint, this.hintTimer && s(this.hintTimer), this.hintTimer = n(() => {
        this.hint = "";
      }, 3e3)), !t.hint && (this.hint = "", this.hintTimer && s(this.hintTimer)), this.enabled = t.enabled, this.audioValidated = t.audioValidated, this.autoLabel = "电脑连接自动启用：" + (t.autoPc ? "开" : "关"), t.detail ? (this.view = "detail", this.content = "approval" === t.detail.kind && "human" !== t.detail.presentation ? t.detail.reason || "请在电脑端核对此请求。" : t.detail.content, this.pageLabel = t.detail.page + 1 + " / " + t.detail.pages, this.isApproval = "approval" === t.detail.kind, this.contentHeight = this.textHeight(this.content, 24, 34), this.canApprove = this.isApproval && t.detail.canApprove, this.reason = t.detail.reason || "Codex 未提供请求原因。可查看技术详情，或在电脑端确认。") : ("detail" === this.view && (this.view = "inbox"), this.content = "", this.reason = "", this.pageLabel = "", this.canApprove = !1, this.isApproval = !1, this.showTechnical = !1);
    });
  },
  onShow() {
    this.armClock(), this.bridge.checkAudio(), this.bridge.controller.visible(!0), this.bridge.controller.refresh();
  },
  onHide() {
    this.clockTimer && s(this.clockTimer), this.clockTimer = null, this.bindConfirmTimer && s(this.bindConfirmTimer), this.bindConfirm = !1, this.bridge.controller.visible(!1);
  },
  onDestroy() {
